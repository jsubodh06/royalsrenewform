rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Default-Deny Global Catch-All Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Security & Validation Primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedAuth() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedAuth() && request.auth.token.email == 'subodhjain2007777@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPhotoId(id) {
      return id is string && id.size() >= 3 && id.size() <= 160 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    function isValidCoupleId(id) {
      return id is string && id.size() == 5 && id.matches('^JR[0-9]{3}$');
    }

    function isRequiredStr(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isOptionalStr(val, maxLen) {
      return val == null || (val is string && val.size() <= maxLen);
    }

    function isValidMember(data, coupleId) {
      return data.keys().hasAll(['couple_id', 'husband_name', 'wife_name', 'year1_status']) &&
        data.keys().hasOnly([
          'couple_id', 'husband_name', 'wife_name',
          'husband_registered_mobile', 'wife_registered_mobile', 'year1_status'
        ]) &&
        data.couple_id == coupleId &&
        isRequiredStr(data.husband_name, 1, 120) &&
        isRequiredStr(data.wife_name, 1, 120) &&
        isRequiredStr(data.year1_status, 1, 60) &&
        (!('husband_registered_mobile' in data) || isOptionalStr(data.husband_registered_mobile, 20)) &&
        (!('wife_registered_mobile' in data) || isOptionalStr(data.wife_registered_mobile, 20));
    }

    function isValidYear2Profile(data, coupleId) {
      return data.keys().hasAll(['couple_id']) &&
        data.keys().hasOnly([
          'couple_id', 'city', 'residential_address', 'occupation_status',
          'family_status', 'photo_id', 'family_photo_url', 'last_step'
        ]) &&
        data.couple_id == coupleId &&
        (!('city' in data) || isOptionalStr(data.city, 120)) &&
        (!('residential_address' in data) || isOptionalStr(data.residential_address, 500)) &&
        (!('occupation_status' in data) || isOptionalStr(data.occupation_status, 200)) &&
        (!('family_status' in data) || isOptionalStr(data.family_status, 300)) &&
        (!('photo_id' in data) || isOptionalStr(data.photo_id, 160)) &&
        (!('family_photo_url' in data) || isOptionalStr(data.family_photo_url, 1000)) &&
        (!('last_step' in data) || (data.last_step is number && data.last_step >= 1 && data.last_step <= 10));
    }

    function isValidSubmission(data, coupleId) {
      return data.keys().hasAll(['couple_id', 'submission_status', 'submitted_at']) &&
        data.keys().hasOnly(['couple_id', 'submission_status', 'submitted_at', 'submitted_by_mobile']) &&
        data.couple_id == coupleId &&
        data.submission_status in ['submitted', 'approved', 'under_review'] &&
        isRequiredStr(data.submitted_at, 4, 64) &&
        (!('submitted_by_mobile' in data) || isOptionalStr(data.submitted_by_mobile, 20));
    }

    function isValidChildEntry(child) {
      return child is map &&
        child.keys().hasOnly(['id', 'name', 'gender', 'dob', 'education', 'interests', 'photo_url']) &&
        child.id is string && child.id.size() <= 64 &&
        child.name is string && child.name.size() <= 150 &&
        child.gender in ['son', 'daughter'] &&
        child.dob is string && child.dob.size() <= 40 &&
        child.education is string && child.education.size() <= 200 &&
        child.interests is string && child.interests.size() <= 300 &&
        (child.photo_url == null || (child.photo_url is string && child.photo_url.size() <= 1000));
    }

    function isValidFamilyRegistration(data, regId) {
      return data.keys().hasOnly([
          'reg_id', 'membership_type', 'submitted_by_role', 'submitter_email',
          'husband_name', 'husband_mobile', 'husband_email', 'husband_dob',
          'husband_qualification', 'husband_occupation', 'husband_organization',
          'husband_blood_group', 'husband_instagram', 'husband_photo_url',
          'wife_name', 'wife_mobile', 'wife_email', 'wife_dob',
          'wife_qualification', 'wife_occupation', 'wife_organization',
          'wife_blood_group', 'wife_instagram', 'wife_photo_url',
          'marriage_anniversary', 'current_city', 'residential_address', 'native_place',
          'has_children', 'children', 'couple_photo_url', 'family_photo_url',
          'contribution_areas', 'royal_idea', 'jsg_should_be_known_for',
          'president_name', 'president_mobile', 'secretary_name', 'secretary_mobile',
          'other_group_member', 'other_group_name', 'other_group_position', 'new_member_contribution',
          'reference_name', 'reference_mobile', 'business_description',
          'exp_rating', 'exp_favourite_event', 'exp_international_trip',
          'exp_trip_month_destination', 'exp_missing',
          'status', 'created_at', 'updated_at', 'createdAt', 'updatedAt'
        ]) &&
        data.reg_id == regId &&
        data.membership_type in ['existing', 'new'] &&
        data.submitted_by_role in ['husband', 'wife'] &&
        data.submitter_email is string && data.submitter_email.size() <= 200 &&
        data.husband_name is string && data.husband_name.size() <= 150 &&
        data.husband_mobile is string && data.husband_mobile.size() >= 10 && data.husband_mobile.size() <= 20 &&
        data.husband_email is string && data.husband_email.size() <= 200 &&
        data.wife_name is string && data.wife_name.size() <= 150 &&
        data.wife_mobile is string && data.wife_mobile.size() >= 10 && data.wife_mobile.size() <= 20 &&
        data.wife_email is string && data.wife_email.size() <= 200 &&
        data.marriage_anniversary is string && data.marriage_anniversary.size() <= 40 &&
        data.current_city is string && data.current_city.size() <= 120 &&
        data.residential_address is string && data.residential_address.size() <= 600 &&
        data.has_children is bool &&
        data.children is list &&
        data.children.size() <= 10 &&
        (data.children.size() == 0 || isValidChildEntry(data.children[0])) &&
        data.status in ['submitted', 'pending_review', 'approved', 'rejected'] &&
        (!('created_at' in data) || (data.created_at is string && data.created_at.size() <= 64)) &&
        data.updated_at is string && data.updated_at.size() <= 64 &&
        ('' + data.husband_dob + data.husband_qualification + data.husband_occupation +
          data.husband_organization + data.husband_blood_group + data.husband_instagram).size() <= 770 &&
        ('' + data.wife_dob + data.wife_qualification + data.wife_occupation +
          data.wife_organization + data.wife_blood_group + data.wife_instagram).size() <= 770 &&
        ('' + data.husband_photo_url + data.wife_photo_url +
          data.couple_photo_url + data.family_photo_url).size() <= 4000 &&
        ('' + data.native_place + data.contribution_areas + data.royal_idea +
          data.jsg_should_be_known_for + data.president_name + data.president_mobile +
          data.secretary_name + data.secretary_mobile).size() <= 5550 &&
        ('' + data.other_group_member + data.other_group_name + data.other_group_position +
          data.new_member_contribution + data.reference_name + data.reference_mobile +
          data.business_description).size() <= 4580 &&
        ('' + data.exp_favourite_event + data.exp_international_trip +
          data.exp_trip_month_destination + data.exp_missing).size() <= 3800 &&
        (data.exp_rating == null || (data.exp_rating is number && data.exp_rating >= 1 && data.exp_rating <= 10));
    }

    function isValidNewMemberApplication(data, appId) {
      return data.keys().hasOnly([
          'app_id', 'applicant_name', 'business_name', 'mobile_number', 'email',
          'other_group_member', 'other_group_name', 'other_group_position', 'contribution',
          'reference_name', 'reference_mobile', 'business_description',
          'president_name', 'president_mobile', 'secretary_name', 'secretary_mobile',
          'status', 'created_at', 'updated_at', 'createdAt', 'updatedAt'
        ]) &&
        data.app_id == appId &&
        data.applicant_name is string && data.applicant_name.size() >= 1 && data.applicant_name.size() <= 150 &&
        data.business_name is string && data.business_name.size() >= 1 && data.business_name.size() <= 200 &&
        data.mobile_number is string && data.mobile_number.size() >= 10 && data.mobile_number.size() <= 20 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        data.other_group_member in ['Yes', 'No'] &&
        data.contribution is string && data.contribution.size() >= 1 && data.contribution.size() <= 2000 &&
        data.reference_name is string && data.reference_name.size() >= 1 && data.reference_name.size() <= 150 &&
        data.reference_mobile is string && data.reference_mobile.size() >= 10 && data.reference_mobile.size() <= 20 &&
        data.business_description is string && data.business_description.size() >= 1 && data.business_description.size() <= 2000 &&
        data.status in ['pending_review', 'approved', 'rejected'] &&
        (!('created_at' in data) || (data.created_at is string && data.created_at.size() >= 4 && data.created_at.size() <= 64)) &&
        data.updated_at is string && data.updated_at.size() >= 4 && data.updated_at.size() <= 64 &&
        (!('other_group_name' in data) || isOptionalStr(data.other_group_name, 200)) &&
        (!('other_group_position' in data) || isOptionalStr(data.other_group_position, 200)) &&
        (!('president_name' in data) || isOptionalStr(data.president_name, 150)) &&
        (!('president_mobile' in data) || isOptionalStr(data.president_mobile, 25)) &&
        (!('secretary_name' in data) || isOptionalStr(data.secretary_name, 150)) &&
        (!('secretary_mobile' in data) || isOptionalStr(data.secretary_mobile, 25));
    }

    function isValidFamilyPhoto(data, photoId) {
      return data.keys().hasAll(['photo_id', 'mime_type', 'data_url', 'size_bytes', 'created_at', 'createdAt']) &&
        data.keys().hasOnly(['photo_id', 'mime_type', 'data_url', 'size_bytes', 'created_at', 'createdAt']) &&
        data.photo_id == photoId &&
        data.mime_type in ['image/jpeg', 'image/png', 'image/webp'] &&
        data.data_url is string &&
        data.data_url.size() >= 20 &&
        data.data_url.size() <= 650000 &&
        data.data_url[0:11] == 'data:image/' &&
        data.size_bytes is number &&
        data.size_bytes > 0 &&
        data.size_bytes <= 650000 &&
        data.created_at is string && data.created_at.size() >= 4 && data.created_at.size() <= 64;
    }

    function isValidMemberVault(data, vaultId) {
      return data.keys().hasAll(['vault_id', 'reg_id', 'iv', 'auth_tag', 'ciphertext', 'updated_at', 'updatedAt']) &&
        data.keys().hasOnly([
          'vault_id', 'reg_id', 'iv', 'auth_tag', 'ciphertext',
          'created_at', 'updated_at', 'createdAt', 'updatedAt'
        ]) &&
        data.vault_id == vaultId &&
        isValidId(data.reg_id) &&
        data.iv is string && data.iv.size() >= 12 && data.iv.size() <= 64 &&
        data.auth_tag is string && data.auth_tag.size() >= 16 && data.auth_tag.size() <= 64 &&
        data.ciphertext is string && data.ciphertext.size() >= 20 && data.ciphertext.size() <= 120000 &&
        (!('created_at' in data) || (data.created_at is string && data.created_at.size() >= 4 && data.created_at.size() <= 64)) &&
        data.updated_at is string && data.updated_at.size() >= 4 && data.updated_at.size() <= 64;
    }

    function isHouseholdEmailMatch(incomingEmail, prev) {
      let email = incomingEmail.lower();
      return (
        ('submitter_email' in prev && prev.submitter_email is string && email == prev.submitter_email.lower()) ||
        ('husband_email' in prev && prev.husband_email is string && email == prev.husband_email.lower()) ||
        ('wife_email' in prev && prev.wife_email is string && email == prev.wife_email.lower())
      );
    }

    function canUpdateFamilyRegistration(d, e, regId) {
      return (!('reg_id' in e) || d.reg_id == e.reg_id) &&
        (!('createdAt' in e) || d.createdAt == e.createdAt) &&
        (!('created_at' in e) || d.created_at == e.created_at) &&
        d.updatedAt == request.time &&
        (
          (
            isAdmin() &&
            d.diff(e).affectedKeys().hasOnly(['status', 'updated_at', 'updatedAt']) &&
            d.status in ['submitted', 'pending_review', 'approved', 'rejected'] &&
            d.updated_at is string && d.updated_at.size() <= 64
          ) || (
            isValidFamilyRegistration(d, regId) &&
            (
              isAdmin() || (
                (!('status' in e) || e.status in ['submitted', 'pending_review']) &&
                d.status in ['submitted', 'pending_review'] &&
                isHouseholdEmailMatch(d.submitter_email, e)
              )
            )
          )
        );
    }

    function canUpdateNewMemberApplication(d, e, appId) {
      return (!('app_id' in e) || d.app_id == e.app_id) &&
        (!('createdAt' in e) || d.createdAt == e.createdAt) &&
        (!('created_at' in e) || d.created_at == e.created_at) &&
        d.updatedAt == request.time &&
        (
          (
            isAdmin() &&
            d.diff(e).affectedKeys().hasOnly(['status', 'updated_at', 'updatedAt']) &&
            d.status in ['pending_review', 'approved', 'rejected'] &&
            d.updated_at is string && d.updated_at.size() <= 64
          ) || (
            isValidNewMemberApplication(d, appId) &&
            (
              isAdmin() || (
                (!('status' in e) || e.status == 'pending_review') &&
                d.status == 'pending_review' &&
                'email' in e && e.email is string &&
                d.email.lower() == e.email.lower()
              )
            )
          )
        );
    }

    // 3. Members collection: Master Year-1 records (Admin managed)
    match /members/{coupleId} {
      allow get: if isValidCoupleId(coupleId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidCoupleId(coupleId) && isAdmin() && isValidMember(incoming(), coupleId);
      allow update: if isValidCoupleId(coupleId) && isAdmin() && isValidMember(incoming(), coupleId) &&
        incoming().couple_id == existing().couple_id;
      allow delete: if isValidCoupleId(coupleId) && isAdmin();
    }

    // 4. Year-2 profiles & drafts (Admin managed)
    match /year2_profiles/{coupleId} {
      allow get: if isValidCoupleId(coupleId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidCoupleId(coupleId) && isAdmin() && isValidYear2Profile(incoming(), coupleId);
      allow update: if isValidCoupleId(coupleId) && isAdmin() && isValidYear2Profile(incoming(), coupleId) &&
        incoming().couple_id == existing().couple_id;
      allow delete: if isValidCoupleId(coupleId) && isAdmin();
    }

    // 5. Submissions (Admin managed)
    match /submissions/{coupleId} {
      allow get: if isValidCoupleId(coupleId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidCoupleId(coupleId) && isAdmin() && isValidSubmission(incoming(), coupleId);
      allow update: if isValidCoupleId(coupleId) && isAdmin() && isValidSubmission(incoming(), coupleId) &&
        incoming().couple_id == existing().couple_id;
      allow delete: if isValidCoupleId(coupleId) && isAdmin();
    }

    // 6. Family Registrations: Dossier upsert by registered household email; Admin or verified household owner read
    match /family_registrations/{regId} {
      allow get: if isValidId(regId) && (
        isAdmin() || (
          isVerifiedAuth() &&
          (resource == null || isHouseholdEmailMatch(request.auth.token.email, resource.data))
        )
      );
      allow list: if isAdmin();
      allow create: if isValidId(regId) &&
        'created_at' in request.resource.data &&
        isValidFamilyRegistration(request.resource.data, regId) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.status in ['submitted', 'pending_review'];
      allow update: if isValidId(regId) &&
        canUpdateFamilyRegistration(request.resource.data, resource.data, regId);
      allow delete: if isValidId(regId) && isAdmin();
    }

    // 7. New Member Applications: Upsert by applicant email; Admin-only read/list/delete & status updates
    match /new_member_applications/{appId} {
      allow get: if isValidId(appId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(appId) &&
        'created_at' in request.resource.data &&
        isValidNewMemberApplication(request.resource.data, appId) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.status == 'pending_review';
      allow update: if isValidId(appId) &&
        canUpdateNewMemberApplication(request.resource.data, resource.data, appId);
      allow delete: if isValidId(appId) && isAdmin();
    }

    // 8. Family Photos: Persistent compressed photo backups for Admin review across deploys
    match /family_photos/{photoId} {
      allow get: if isValidPhotoId(photoId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidPhotoId(photoId) &&
        isValidFamilyPhoto(incoming(), photoId) &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidPhotoId(photoId) && isAdmin();
    }

    // 9. Member Vaults: Zero-PII AES-256-GCM encrypted lookup blobs tied to parent family_registrations
    match /member_vaults/{vaultId} {
      allow get: if isValidId(vaultId) && (
        isAdmin() ||
        resource == null || (
          'reg_id' in resource.data &&
          isValidId(resource.data.reg_id) &&
          exists(/databases/$(database)/documents/family_registrations/$(resource.data.reg_id))
        )
      );
      allow list: if isAdmin();
      allow create: if isValidId(vaultId) &&
        'created_at' in request.resource.data &&
        isValidMemberVault(request.resource.data, vaultId) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        exists(/databases/$(database)/documents/family_registrations/$(request.resource.data.reg_id));
      allow update: if isValidId(vaultId) &&
        isValidMemberVault(request.resource.data, vaultId) &&
        (!('vault_id' in resource.data) || request.resource.data.vault_id == resource.data.vault_id) &&
        (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt) &&
        (!('created_at' in resource.data) || request.resource.data.created_at == resource.data.created_at) &&
        request.resource.data.updatedAt == request.time &&
        exists(/databases/$(database)/documents/family_registrations/$(request.resource.data.reg_id));
      allow delete: if isValidId(vaultId) && isAdmin();
    }
  }
}
